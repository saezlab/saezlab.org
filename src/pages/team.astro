---
import Layout from '../layouts/Layout.astro';
import TeamMemberCardLink from '../components/TeamMemberCardLink';
import TeamMemberCardDialog from '../components/TeamMemberCardDialog';
import AlumniCard from '../components/AlumniCard.astro';
import { getInternalLink } from '../lib/utils';
import { getCollection } from 'astro:content';
// Interfaces for GitHub team data
interface TeamMember {
  login: string;
  name: string | null;
  avatar_url: string;
  bio: string | null;
  email: string | null;
  location: string | null;
  html_url: string;
}

interface Team {
  name: string;
  slug: string;
  members: TeamMember[];
}

interface TeamData {
  teams: Team[];
}

// Member profiles are maintained in src/content/members/*.yaml.
const members = await getCollection('members');
const currentTeam = members
  .filter(member => member.data.status === 'current')
  .map(member => ({ ...member.data, slug: member.id }))
  .sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));
const alumni = members
  .filter(member => member.data.status === 'alumni')
  .map(member => member.data)
  .sort((a, b) => (b.membership?.end_year ?? 0) - (a.membership?.end_year ?? 0)
    || a.order - b.order || a.name.localeCompare(b.name));

// Fetch GitHub team data
const githubTeamsCollection = await getCollection('teams_loaded');
const githubTeamData = githubTeamsCollection[0]?.data as unknown as TeamData | undefined;

// Find Interns and Visitors teams from GitHub data
const internsAndVisitorsTeam = githubTeamData?.teams.find(team => team.slug.toLowerCase() === 'intern-visitor');

// List of team members to exclude from display
const excludedMembers = ['Inga Ulusoy'];

---

<Layout title="Team">
  <div class="container py-6 md:py-12">
    <div class="mx-auto max-w-[980px]">
      <h1 class="mb-4 text-3xl font-bold leading-tight tracking-tighter md:text-6xl lg:leading-[1.1]">
        Our Team
      </h1>
      <p class="max-w-[750px] text-lg text-muted-foreground sm:text-xl">
        Meet the people behind our research
      </p>
    </div>

    <div class="mx-auto max-w-[980px] py-6 md:py-12">
      <h2 class="mb-8 text-2xl font-bold">Group Leader</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {currentTeam.filter(member => member.group === "group-leader").map((member) => (
          <TeamMemberCardLink
            slug={member.slug}
            client:load
            name={member.name}
            role={member.role}
            image={getInternalLink("/team_images/" + member.image)}
            bio={member.description}
            email={member.email}
            telephone={member.telephone}
            orcid={member.orcid}
            research_interests={member.research_interests}
            professional_career={member.professional_career}
            education={member.education}
          />
        ))}
      </div>
    </div>

    <div class="mx-auto max-w-[980px] py-6 md:py-12">
      <h2 class="mb-8 text-2xl font-bold">Administration</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {currentTeam.filter(member => member.group === "administration").map((member) => (
          <TeamMemberCardLink
            slug={member.slug}
            client:load
            name={member.name}
            role={member.role}
            image={getInternalLink("/team_images/" + member.image)}
            bio={member.description}
            email={member.email}
            telephone={member.telephone}
            orcid={member.orcid}
            research_interests={member.research_interests}
            professional_career={member.professional_career}
            education={member.education}
          />
        ))}
      </div>
    </div>

    <div class="mx-auto max-w-[980px] py-6 md:py-12">
      <h2 class="mb-8 text-2xl font-bold">Staff Scientists</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {currentTeam.filter(member => member.group === "staff-scientists").map((member) => (
          <TeamMemberCardLink
            slug={member.slug}
            client:load
            name={member.name}
            role={member.role}
            image={getInternalLink("/team_images/" + member.image)}
            bio={member.description}
            email={member.email}
            telephone={member.telephone}
            orcid={member.orcid}
            research_interests={member.research_interests}
            professional_career={member.professional_career}
            education={member.education}
          />
        ))}
      </div>
    </div>

    <div class="mx-auto max-w-[980px] py-6 md:py-12">
      <h2 class="mb-8 text-2xl font-bold">Postdocs</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {currentTeam.filter(member => member.group === "postdocs").map((member) => (
          <TeamMemberCardLink
            slug={member.slug}
            client:load
            name={member.name}
            role={member.role}
            image={getInternalLink("/team_images/" + member.image)}
            bio={member.description}
            email={member.email}
            telephone={member.telephone}
            orcid={member.orcid}
            research_interests={member.research_interests}
            professional_career={member.professional_career}
            education={member.education}
          />
        ))}
      </div>
    </div>

    <div class="mx-auto max-w-[980px] py-6 md:py-12">
      <h2 class="mb-8 text-2xl font-bold">PhD Students</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {currentTeam.filter(member => member.group === "phd-students").map((member) => (
          <TeamMemberCardLink
            slug={member.slug}
            client:load
            name={member.name}
            role={member.role}
            image={getInternalLink("/team_images/" + member.image)}
            bio={member.description}
            email={member.email}
            telephone={member.telephone}
            orcid={member.orcid}
            research_interests={member.research_interests}
            professional_career={member.professional_career}
            education={member.education}
          />
        ))}
      </div>
    </div>

    <div class="mx-auto max-w-[980px] py-6 md:py-12">
      <h2 class="mb-8 text-2xl font-bold">Associated Members</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {currentTeam.filter(member => member.group === "associated-members").map((member) => (
          <TeamMemberCardLink
            slug={member.slug}
            client:load
            name={member.name}
            role={member.role}
            image={getInternalLink("/team_images/" + member.image)}
            bio={member.description}
            email={member.email}
            telephone={member.telephone}
            orcid={member.orcid}
            research_interests={member.research_interests}
            professional_career={member.professional_career}
            education={member.education}
          />
        ))}
      </div>
    </div>

    {/* Interns & Visitors Section (from GitHub) */}
    {internsAndVisitorsTeam && internsAndVisitorsTeam.members.length > 0 && (
      <div class="mx-auto max-w-[980px] py-6 md:py-12">
        <h2 class="mb-8 text-2xl font-bold">Interns & Visitors</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {internsAndVisitorsTeam.members
            .filter((member: TeamMember) => !excludedMembers.includes(member.name || member.login))
            .map((member: TeamMember) => (
            <TeamMemberCardDialog
              client:load
              name={member.name || member.login}
              role="Intern / Visitor"
              image={member.avatar_url}
              bio={member.bio || ''}
              email={member.email || ''}
              github_url={member.html_url}
              research_interests=""
              professional_career={[]}
              education={[]}
            />
          ))}
        </div>
      </div>
    )}

    <div class="mx-auto max-w-[980px] py-6 md:py-12">
      <h2 class="mb-8 text-2xl font-bold">Alumni</h2>
      <p class="mb-8 text-muted-foreground">The following people spent over 6 months with us:</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {alumni.map((member) => (
          <AlumniCard
            name={member.name}
            position={member.role}
            duration={[member.membership?.start_year, member.membership?.end_year].filter(year => year !== undefined).join("-")}
            linkedin={member.linkedin}
          />
        ))}
      </div>
    </div>
  </div>
</Layout> 